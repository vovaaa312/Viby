<?xml version="1.0" encoding="utf-8"?>
<!-- Shared mini player (playlist screen, library). Bound by MiniPlayerBinder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayer"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_mini_player"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <ImageView
        android:id="@+id/miniThumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/cover_desc"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        app:tint="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/miniTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/no_track"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/viby_on_control_panel"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/miniArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/viby_on_control_panel" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/miniPrev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_prev"
        android:src="@drawable/ic_skip_previous"
        app:tint="@color/viby_on_control_panel" />

    <ImageButton
        android:id="@+id/miniPlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_play_pause"
        android:src="@drawable/ic_play"
        app:tint="@color/viby_on_control_panel" />

    <ImageButton
        android:id="@+id/miniNext"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_next"
        android:src="@drawable/ic_skip_next"
        app:tint="@color/viby_on_control_panel" />

</LinearLayout>

