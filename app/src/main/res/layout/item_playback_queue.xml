<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:paddingVertical="8dp">

    <View
        android:id="@+id/queueItemCurrentIndicator"
        android:layout_width="4dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_now_playing_indicator"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/queueItemThumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/cover_desc"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queueItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/queueItemArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/queueItemDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?android:attr/textColorSecondary" />

    <ImageButton
        android:id="@+id/queueItemDelete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove_from_queue"
        android:padding="10dp"
        android:src="@drawable/ic_delete"
        app:tint="?android:attr/textColorSecondary" />

    <ImageView
        android:id="@+id/queueItemDrag"
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:contentDescription="@string/reorder_queue_item"
        android:padding="8dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="?android:attr/textColorSecondary" />
</LinearLayout>
